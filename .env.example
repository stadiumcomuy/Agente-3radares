# Clave de API de Anthropic. Alternativa: `ant auth login`.
ANTHROPIC_API_KEY=

# GA4 por API (o configurá [ga4] en fuentes.toml)
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# MercadoLibre por API (opcional; sin token se leen las páginas públicas)
MELI_ACCESS_TOKEN=

# Opcionales
# RADARES_MODEL=claude-opus-5
# RADARES_DIR=./memoria
# RADARES_MAX_BUSQUEDAS=8
# RADARES_FALLBACKS=1
